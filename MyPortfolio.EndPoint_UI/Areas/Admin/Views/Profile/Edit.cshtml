@model MyPortfolio.Application.ViewModels.ProfileViewModel

<form method="post" enctype="multipart/form-data">

    <div>
        <label asp-for="FullNameEn"> نام انگلیسی</label>
        <input asp-for="FullNameEn" type="text" />
    </div>

    <div>
        <label asp-for="FullNameFa">نام فارسی </label>
        <input asp-for="FullNameFa" type="text" />
    </div>

    <div>
        <label asp-for="JobTitleEn">عنوان شغلی به انگلیسی</label>
        <input asp-for="JobTitleEn" type="text" />
    </div>

    <div>
        <label asp-for="JobTitleFa">عنوان شغلی به فارسی</label>
        <input asp-for="JobTitleFa" type="text" />
    </div>
    <div>
        <label asp-for="DescriptionFa">توضیحات</label>
        <textarea asp-for="DescriptionFa" rows="5" class="form-control"></textarea>
        <span asp-validation-for="DescriptionFa"></span>
    </div>
    <div>
        <label asp-for="DescriptionEn"> توضیحات به آلمانی</label>
        <textarea asp-for="DescriptionEn" rows="5" class="form-control"></textarea>
        <span asp-validation-for="DescriptionEn"></span>
    </div>

    <div>
        <label>انتخاب عکس پروفایل:</label>
        <input name="imageFile" type="file" />
    </div>

    <button type="submit">ذخیره</button>

</form>
