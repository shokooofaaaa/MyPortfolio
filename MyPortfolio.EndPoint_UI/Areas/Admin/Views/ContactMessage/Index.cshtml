@model MyPortfolio.Application.ViewModels.PagedListViewModel<MyPortfolio.Application.ViewModels.ContactMessageViewModel>


<div class="message-section">
    <h2>پیام ها </h2>

    <div class="container mt-5" dir="rtl">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">مدیریت پیام ها</h2>

     
  @if (Model == null || !Model.Items.Any())
    {
        <div class="alert alert-info text-center p-4">
            هنوز هیچ پیامی ثبت نشده است.
        </div>
    }
    else
    {



<table class="table table-striped table-hover text-center align-middle shadow message-table">
    <thead>
        <tr>
            <th>نام فرستنده</th>

            <th>
            ایمیل قرستنده
              </th>
              <th>

                  متن پیام
              </th>
          
    </thead>

    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Email</td>
                <td>@item.Message</td>

               
            </tr>
        }
        
    </tbody>
</table>

        }
    </div>

<style>

  body {
                background: #f6e9ff;
            }

            .message-table {
                background: #fff;
                border-radius: 16px;
                overflow: hidden;
                border: none;
                box-shadow: 0 12px 30px rgba(120, 60, 160, 0.25);
            }

                .message-table thead {
                background: linear-gradient(90deg, #7b2cbf, #e1007a);
                color: #fff;
            }

                    .message-table thead th {
                    border: none;
                    font-weight: 600;
                    font-size: 0.95rem;
                }

                .message-table tbody tr {
                transition: background-color 0.2s ease, transform 0.15s ease;
            }

                    .message-table tbody tr:nth-child(even) {
                    background-color: #fdf5ff;
                }

                    .message-table tbody tr:hover {
                    background-color: #f7e0ff;
                    transform: translateY(-2px);
                }

                .message-table td {
                vertical-align: middle;
                border-top: none;
                font-size: 0.9rem;
                color: #4a306d;
            }

            
        </style>