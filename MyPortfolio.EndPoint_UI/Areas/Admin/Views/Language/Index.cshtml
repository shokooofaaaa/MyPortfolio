@model MyPortfolio.Application.ViewModels.PagedListViewModel<MyPortfolio.Application.ViewModels.LanguageViewModel>


<div class="skills-section">
    <h2>زبان ها </h2>

    <div class="container mt-5" dir="rtl">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">مدیریت زبان ها</h2>

        <a asp-controller="Language"
           asp-action="Create"
           class="btn btn-success px-4">
            + افزودن زبان جدید
        </a>
    </div>

  @if (Model == null || !Model.Items.Any())
    {
        <div class="alert alert-info text-center p-4">
            هنوز هیچ زبانی ثبت نشده است.
        </div>
    }
    else
    {



<table class="table table-striped table-hover text-center align-middle shadow language-table">
    <thead>
        <tr>
            <th>عنوان زبان</th>

            <th>
                سطح زبان
              </th>
            <th style="width:140px;">عملیات</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Level</td>

                <td>
                    <a asp-controller="Language"
                       asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-warning btn-sm btn-edit">
                        ویرایش
                    </a>

                    <form asp-controller="Language"
                          asp-action="Delete"
                          asp-route-id="@item.Id"
                          method="post"
                          style="display:inline">

                        <button type="submit"
                                class="btn btn-danger btn-sm">
                            حذف
                        </button>
                    </form>
                </td>
            </tr>
        }
        
    </tbody>
</table>

        }
    </div>

