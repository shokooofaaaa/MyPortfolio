@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@model MyPortfolio.Application.DataTransferObject.LoginDto
@{
    ViewData["Title"] = "ورود به حساب";
    Layout = null; 
    }
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: "IRANSans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            background: linear-gradient(135deg, #f6dce7, #f3f0fa);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-wrapper {
            width: 100%;
            max-width: 420px;
            padding: 16px;
        }

        .login-card {
            background: rgba(255, 255, 255, 0.92);
            border-radius: 24px;
            padding: 32px 28px 24px;
            box-shadow:
                0 18px 40px rgba(0, 0, 0, 0.08),
                0 1px 0 rgba(255, 255, 255, 0.6);
            backdrop-filter: blur(16px);
            text-align: center;
        }

        .login-title {
            margin: 0 0 24px;
            font-size: 22px;
            font-weight: 700;
            color: #4b3142;
        }

        .form-group {
            margin-bottom: 16px;
            text-align: right;
        }

        .form-input {
            width: 100%;
            padding: 10px 16px;
            border-radius: 999px;
            border: 1px solid #d9c7d8;
            background-color: #fdfbff;
            font-size: 14px;
            outline: none;
            color: #3a2b35;
            transition: all 0.2s ease;
        }

        .form-input::placeholder {
            color: #c1b0c0;
            font-size: 13px;
        }

        .form-input:focus {
            border-color: #c46a83;
            box-shadow: 0 0 0 3px rgba(196, 106, 131, 0.18);
            background-color: #ffffff;
        }

        .validation-message {
            color: #d9534f;
            font-size: 12px;
            margin-top: 4px;
            text-align: right;
        }

        .btn {
            width: 100%;
            border-radius: 999px;
            padding: 10px 16px;
            border: none;
            font-size: 14px;
            cursor: pointer;
            margin-bottom: 10px;
            transition: all 0.2s ease;
        }

        .btn-secondary {
            background: #a7a6aa;
            color: #fff;
        }

        .btn-secondary:hover {
            background: #949398;
        }

        .btn-primary {
            background: #c55972;
            color: #fff;
            box-shadow: 0 8px 18px rgba(197, 89, 114, 0.35);
        }

        .btn-primary:hover {
            background: #b24b64;
            box-shadow: 0 10px 22px rgba(178, 75, 100, 0.4);
        }

        .login-links {
            margin-top: 6px;
            font-size: 13px;
            color: #865769;
        }

        .login-links a {
            color: inherit;
            text-decoration: none;
        }

        .login-links a:hover {
            text-decoration: underline;
        }

        

        .social-icons {
            margin-top: 8px;
            font-size: 18px;
        }

        .social-icons span {
            margin: 0 4px;
            cursor: default;
        }

        media (max-width: 480px) {
            .login-card

        {
            padding: 24px 18px 20px;
        }
        }
    </style>
</head>
<body>
    <div class="login-wrapper">
        <div class="login-card">
            <h1 class="login-title">ورود به حساب</h1>

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="validation-message" style="text-align:center; margin-bottom:10px;">
                    @ViewBag.ErrorMessage
                </div>
            }

            <form asp-action="Login" asp-area="Admin" asp-controller="Account" method="post">
                <div class="form-group">
                    <input asp-for="Username" class="form-input"
                           placeholder="ایمیل یا نام کاربری" />
                    <span asp-validation-for="Username" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <input asp-for="Password" class="form-input"
                           placeholder="گذرواژه " />
                    <span asp-validation-for="Password" class="validation-message"></span>
                </div>

               
                <button type="submit" class="btn btn-primary">
                    ورود
                </button>
            </form>

           
        </div>

      

    <partial name="_ValidationScriptsPartial" />
</body>
</html>

