@model MyPortfolio.Application.ViewModels.PagedListViewModel<MyPortfolio.Application.ViewModels.EducationViewModel>


@{
    ViewData["Title"] = "مدیریت تحصیلات";
}

<div class="container mt-5" dir="rtl">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">مدیریت تحصیلات</h2>

        <a asp-controller="Education"
           asp-action="Create"
           class="btn btn-success px-4">
            + افزودن تحصیلات جدید
        </a>
    </div>

    @if (Model == null || !Model.Items.Any())
    {
        <div class="alert alert-info text-center p-4">
            هنوز هیچ تحصیلاتی ثبت نشده است.
        </div>
    }
    else
    {
        <table class="table table-striped table-hover text-center align-middle shadow">
            <thead class="table-dark">
                <tr>
                    <th>عنوان تحصیلات فارسی </th>
                    <th>عنوان تحصیلات انگلیسی </th>

                    <th>   فارسی اسم موسسه</th>
                    <th>    انگلیسی اسم موسسه</th>

                    <th>تاریخ شروع</th>
                    <th>تاریخ پایان</th>
                    <th>  فارسی توضیحات</th>
                    <th>  انگلیسی  توضیحات</th>

                    <th style="width:140px;">عملیات</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var education in Model.Items)
                {
                    <tr>
                        <td>@education.TitleFa</td>
                        <td>@education.TitleEn</td>

                        <td>@education.InstituteNameFa</td>
                        <td>@education.InstituteNameEn</td>

                        <td>@education.DateOfStart</td>
                        <td>@education.DateOfEnd</td>
                        <td>@education.DescriptionFa</td>
                        <td>@education.DescriptionEn</td>





                        <td>
                            <a asp-controller="Education"
                               asp-action="Edit"
                               asp-route-id="@education.Id"
                               class="btn btn-warning btn-sm">
                                ویرایش
                            </a>

                            <form asp-controller="Education"
                                  asp-action="Delete"
                                  asp-route-id="@education.Id"
                                  method="post"
                                  style="display:inline">

                                <button type="submit"
                                        class="btn btn-danger btn-sm">
                                    حذف
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="pagination">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <a class="@(i == Model.CurrentPage ? "active" : "")"
                   href="@Url.Action("Index", new { page = i })">
                    @i
                </a>
            }
        </div>

    }


    <script>
        document.addEventListener("click", async function (e) {

            if (!e.target.classList.contains("btn-delete"))
                return;

            const id = e.target.getAttribute("data-id");

            if (!confirm("آیا مطمئن هستید که می‌خواهید این تجربه را حذف کنید؟"))
                return;

            const response = await fetch('/WorkExperience/Delete', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ id: id })
            });

            const result = await response.json();

            if (result.success) {
                alert("تجربه با موفقیت حذف شد");


                const item = e.target.closest(".WorkExperience-item");
                if (item) {
                    item.remove();
                }
            } else {
                alert(result.message ?? "خطایی رخ داد");
            }
        });
    </script>


</div>


