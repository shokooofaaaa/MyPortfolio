@model MyPortfolio.Application.ViewModels.ProjectViewModel

<h2>ایجاد پروژه جدید</h2>

<form asp-area="Admin" asp-action="Create" asp-controller="Project" method="post" enctype="multipart/form-data">

    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label asp-for="TitleFa"></label>
        <input asp-for="TitleFa" class="form-control" />
        <span asp-validation-for="TitleFa"></span>
    </div>
    <div class="mb-3">
        <label asp-for="TitleEn"></label>
        <input asp-for="TitleEn" class="form-control" />
        <span asp-validation-for="TitleFa"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DescriptionFa"></label>
        <textarea asp-for="DescriptionFa" class="form-control"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="DescriptionEn"></label>
        <textarea asp-for="DescriptionEn" class="form-control"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="GithubUrl"></label>
        <input asp-for="GithubUrl" class="form-control" />
    </div>
    <div>
        <label>انتخاب عکس :</label>
        <input name="imageFile" type="file" />
    </div>
    <button class="btn btn-success">
        ذخیره
    </button>

</form>

