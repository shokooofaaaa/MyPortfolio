@model MyPortfolio.Application.ViewModels.ProjectViewModel

<h2>ایجاد پروژه جدید</h2>

<form asp-area="Admin"  asp-action="Create" asp-controller="Project" method="post">

    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label asp-for="Title"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="GithubUrl"></label>
        <input asp-for="GithubUrl" class="form-control" />
    </div>

    <button class="btn btn-success">
        ذخیره
    </button>

</form>

