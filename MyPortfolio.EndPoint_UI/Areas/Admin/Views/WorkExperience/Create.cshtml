@model MyPortfolio.Application.ViewModels.WorkExperienceViewModel

<h2>ایجاد تجربه جدید</h2>

<form asp-area="Admin" asp-action="Create" asp-controller="WorkExperience" method="post">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="TitleFa" class="form-label"></label>
        <input asp-for="TitleFa" class="form-control" />
        <span asp-validation-for="TitleFa" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="TitleEn" class="form-label"></label>
        <input asp-for="TitleEn" class="form-control" />
        <span asp-validation-for="TitleEn" class="text-danger"></span>
    </div>

    <div class="mb-3">


        <label asp-for="CompanyNameFa"></label>
        <input asp-for="CompanyNameFa" class="form-control" />
        <span asp-validation-for="CompanyNameFa"></span>
    </div>

    <div class="mb-3">


        <label asp-for="CompanyNameEn"></label>
        <input asp-for="CompanyNameEn" class="form-control" />
        <span asp-validation-for="CompanyNameEn"></span>
    </div>
    <div class="form-group">
        <label asp-for="DateOfStart"></label>
        <input asp-for="DateOfStart" class="form-control" placeholder="1403/01/15" />
        <span asp-validation-for="DateOfStart" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="DateOfEnd"></label>
        <input asp-for="DateOfEnd" class="form-control" placeholder="1403/06/20" />
        <span asp-validation-for="DateOfEnd" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DescriptionFa" class="form-label"></label>
        <textarea asp-for="DescriptionFa" class="form-control"></textarea>
        <span asp-validation-for="DescriptionFa" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DescriptionEn" class="form-label"></label>
        <textarea asp-for="DescriptionEn" class="form-control"></textarea>
        <span asp-validation-for="DescriptionEn" class="text-danger"></span>
    </div>

    <button class="btn btn-success">
        ذخیره
    </button>

</form>

