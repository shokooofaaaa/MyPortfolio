@model MyPortfolio.Application.ViewModels.AboutViewModel

<form asp-action="Index" method="post">
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label for="DescriptionFa">درباره من</label>
        <textarea asp-for="DescriptionFa" class="form-control" rows="5"></textarea>

        <span asp-validation-for="DescriptionFa" class="text-danger"></span>
        
        <label for="DescriptionEn">About me</label>
        <textarea asp-for="DescriptionEn" class="form-control" rows="5"></textarea>

        <span asp-validation-for="DescriptionEn" class="text-danger"></span>

    </div>

    <button type="submit" class="btn btn-primary mt-2">Save</button>




</form>
