@model MyPortfolio.Application.ViewModels.SkillIndexViewModel


<div class="skills-section">
    <h2>مهارت های من </h2>


    <form id="skillForm" asp-controller="Skill" asp-action="create" method="post">

        <input id="skillName" asp-for="@Model.SkillForm.Name" type="text" placeholder="نام مهارت"/>


        <input asp-for="@Model.SkillForm.Level" id="skillLevel" type="number" placeholder="درصد مهارت" min="0" max="100" /> 

        <button type="submit"> 
            افزودن مهارت 

        </button> 

    </form>

</div>



<table class="table table-striped table-hover text-center align-middle shadow skill-table">
    <thead>
        <tr>
            <th>عنوان مهارت</th>
            <th>سطح مهارت</th>
            <th style="width:140px;">عملیات</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.Skills.Items)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Level</td>

                <td>
                    <a asp-controller="Skill"
                       asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-warning btn-sm btn-edit">
                        ویرایش
                    </a>

                    <form asp-controller="Skill"
                          asp-action="Delete"
                          asp-route-id="@item.Id"
                          method="post"
                          style="display:inline">

                        <button type="submit"
                                class="btn btn-danger btn-sm">
                            حذف
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="pagination skill-pagination">
    @for (int i = 1; i <= Model.Skills.TotalPages; i++)
    {
        <a class="@(i == Model.Skills.CurrentPage ? "active" : "")"
           href="@Url.Action("Index", new { page = i })">
            @i
        </a>
    }
</div>

