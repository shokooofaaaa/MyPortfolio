@using MyPortfolio.EndPoint_UI
@using MyPortfolio.EndPoint_UI.Localization
@using System.Globalization
@model MyPortfolio.Application.ViewModels.PagedListViewModel<MyPortfolio.Application.ViewModels.EducationViewModel>

@{
    var isFa = CultureInfo.CurrentUICulture.Name.StartsWith("fa");
}


<section class="resume-section ">
    <h3 class="section-title mb-4">@Localizer["Education"]</h3>

    <div class="timeline-card">
        @foreach (var item in Model.Items)
        {

            <div class="timeline-item">
                <div class="timeline-badge"></div>
                <div class="timeline-content">
                  
                        <span class="timeline-period">@item.DateOfStart - @item.DateOfEnd</span>
                       
                    
                    <span class="timeline-title">@(isFa ? item.TitleFa : item.TitleEn)</span>
                    <div class="timeline-subtitle">@(isFa ? item.InstituteNameFa : item.InstituteNameEn)</div>
                    <ul class="timeline-list">
                        <li>@(isFa ? item.DescriptionFa : item.DescriptionEn)</li>

                    </ul>
                </div>
            </div>



        }
    </div>
</section>
