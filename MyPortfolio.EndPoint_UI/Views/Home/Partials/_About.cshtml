
@using System.Globalization


@model MyPortfolio.Application.ViewModels.AboutViewModel
@{
    var isFa = CultureInfo.CurrentUICulture.Name.StartsWith("fa");
}




<section id="about" class="about-section">
    <div class="about-card">
        <div class="about-header">
            <span>@Localizer["AboutTitle"]</span>
        </div>

        <p class="about-text" id="aboutText">
            @(isFa ? Model.DescriptionFa : Model.DescriptionEn)
        </p>

        <span class="read-more-btn" id="aboutToggle">@Localizer["ReadMore"]</span>
    </div>
</section>

<style>
    .about-section {
        width: 100%;
        margin: 0 !important;
        padding: 0;
    }

    .about-header {
        width: 100%;
        max-width: 1100px;
        margin-bottom: 4px;
        padding-right: 10px;
    }

        .about-header span {
            font-size: 30px;
            font-weight: 900;
            color: #4a1742;
        }

    .about-card {
        background: rgba(255, 245, 250, 0.38);
        width: 100%;
        max-width: 1200px;
        border-radius: 25px;
        padding: 40px;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.40);
        box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.07);
    }

    .about-text {
        line-height: 1.9;
        margin: 0;
        font-size: 16px;
        color: #333;
    }

        .about-text.is-collapsed {
            display: -webkit-box;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 3;
            overflow: hidden;
        }

    .read-more-btn {
        display: block;
        margin-top: 10px;
        background: none;
        border: 0;
        color: #7a1f3d;
        font-weight: 600;
        cursor: pointer;
        padding: 5px 0;
        width: 100px;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const text = document.getElementById('aboutText');
        const btn = document.getElementById('aboutToggle');

        if (!text || !btn) return;

        text.classList.add('is-collapsed');

        setTimeout(() => {
            if (text.scrollHeight <= text.clientHeight) {
                btn.style.display = 'none';
            }
        }, 100);

        btn.addEventListener('click', () => {
            const collapsed = text.classList.toggle('is-collapsed');
            btn.textContent = collapsed ?'@Localizer["ReadMore"]': '@Localizer["ReadLess"]';
        });
    });
</script>
