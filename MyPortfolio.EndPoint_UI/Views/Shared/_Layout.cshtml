<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>پورتفولیو من</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workAndeducation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/skill.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/project.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/language.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/contactMessage.css" asp-append-version="true" />



</head>

<body>
    <header>
        <div class="header-container">
            <nav>
                

                <div class="menu-toggle">☰</div>

                <div class="nav-center">
                    <a href="#about">درباره من</a>
                    <a href="#skills">مهارت‌ها</a>
                    <a href="#projects">نمونه‌کار</a>
                    <a href="#educations">تحصیلات</a>

                    <a href="#experiences">سوابق کاری</a>
                    <a href="#languages">زبان ها</a>
                    <a href="#contact">تماس با من</a>

                    <div class="nav-left">

                        <a asp-controller="Account" asp-action="Login" asp-area="Admin" class=" btn-custom-maroon">
                        ورود به پنل
                    </a>
                    </div>
                </div>
            </nav>
        </div>
    </header>


    <main class="main-container">
        @RenderBody()
    </main>

    <footer>
    </footer>

  <script>
    const toggle = document.querySelector('.menu-toggle');
    const menu = document.querySelector('.nav-center');

    toggle.addEventListener('click', () => {
        menu.classList.toggle('active');
    });
</script>


</body>
</html>
