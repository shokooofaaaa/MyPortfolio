@using System.Globalization
@using MyPortfolio.EndPoint_UI
@using MyPortfolio.EndPoint_UI.Localization



@{
    var culture = CultureInfo.CurrentCulture.Name;
    var direction = culture.StartsWith("fa") ? "rtl" : "ltr";
}



<!DOCTYPE html>
<html lang="@culture" dir="@direction">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@SharedLocalizer["Site_Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workAndeducation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/skill.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/project.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/language.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/contactMessage.css" asp-append-version="true" />


</head>

<body>
    <header>
        <div class="header-container">
            <nav>
                

                <div class="menu-toggle">☰</div>

                <div class="nav-center">
                    <a href="#about">  @SharedLocalizer["Nav_AboutMe"]</a>
                    <a href="#skills">@SharedLocalizer["Nav_Skills"]</a>
                    <a href="#projects">@SharedLocalizer["Nav_Projects"]</a>
                    <a href="#educations">@SharedLocalizer["Nav_Education"]</a>
                    <a href="#experiences">@SharedLocalizer["Nav_Experience"]</a>
                    <a href="#languages">@SharedLocalizer["Nav_Languages"]</a>
                    <a href="#contact">@SharedLocalizer["Nav_Contact"]</a>

                    <div class="nav-left">

                        <a asp-controller="Account" asp-action="Login" asp-area="Admin" class=" btn-custom-maroon">
                            @SharedLocalizer["Nav_AdminLogin"]
                        </a>
                    </div>

                    <li class="nav-item d-flex align-items-center ms-lg-3">
                        <div class="language-switcher">
                            <a href="?culture=fa-IR" class="lang-link @(Context.Request.Query["culture"] == "fa-IR" ? "active" : "")">FA</a>
                            <span class="text-muted mx-1">|</span>
                            <a href="?culture=en-US" " class="lang-link @(Context.Request.Query["culture"] == "en-US" ? "active" : "")">EN</a>
                        </div>
                    </li>

                </div>
            </nav>
        </div>
    </header>


    <main class="main-container">
        @RenderBody()
    </main>

    <footer>
    </footer>
  

  <script>
    const toggle = document.querySelector('.menu-toggle');
    const menu = document.querySelector('.nav-center');

    toggle.addEventListener('click', () => {
        menu.classList.toggle('active');
    });
</script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


</body>
</html>
